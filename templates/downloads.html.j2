{% extends "base.html.j2" %}
{% set active_page = "downloads" %}

{% block title %}Downloads: CVE Remediation Snapshot{% endblock %}

{% block hero %}
  <div class="hero py-4 mb-5">
    <div class="container">
      <p class="section-eyebrow text-white-50 mb-2">Data</p>
      <h1 class="mb-0">Downloads</h1>
    </div>
  </div>
{% endblock %}

{% block content %}
  <div class="card mb-4">
    <div class="card-body">
      <h5 class="card-title">Files</h5>
      <p class="card-text text-muted">
        Download the complete history as a single compressed file, or grab just the year you need.
        Generated {{ generated_at }} UTC.
      </p>
      <div class="table-responsive mb-0">
        <table class="table table-sm align-middle">
          <thead>
            <tr>
              <th>Year</th>
              <th class="text-end">Records</th>
              <th>CSV</th>
              <th class="text-end">Size</th>
              <th>Parquet</th>
              <th class="text-end">Size</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">All years</th>
              <td class="text-end">{{ "{:,}".format(record_count) }}</td>
              <td>🗜️ <a href="{{ csv_gz_filename }}">{{ csv_gz_filename }}</a></td>
              <td class="text-end">{{ csv_gz_size }}</td>
              <td>📦 <a href="{{ parquet_filename }}">{{ parquet_filename }}</a></td>
              <td class="text-end">{{ parquet_size }}</td>
            </tr>
            {% for file in year_files %}
            <tr>
              <th scope="row">{{ file.year }}</th>
              <td class="text-end">{{ "{:,}".format(file.record_count) }}</td>
              <td>📄 <a href="{{ file.csv.filename }}">{{ file.csv.filename }}</a></td>
              <td class="text-end">{{ file.csv.size }}</td>
              <td>📦 <a href="{{ file.parquet.filename }}">{{ file.parquet.filename }}</a></td>
              <td class="text-end">{{ file.parquet.size }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <h5 class="card-title">Using with dbt</h5>
      <p class="card-text text-muted">
        To use this snapshot as a <a href="https://docs.getdbt.com/docs/build/seeds" target="_blank" rel="noopener">dbt seed</a>,
        download the gzip-compressed file (all years) into your project's <code>seeds/</code> directory and unzip it:
      </p>
      <pre class="bg-body-tertiary p-3 rounded mb-0"><code>curl -L -o seeds/{{ csv_gz_filename }} https://cve-db.pages.dev/{{ csv_gz_filename }}
gunzip seeds/{{ csv_gz_filename }}
dbt seed --select {{ csv_gz_filename[:-7] }}</code></pre>
    </div>
  </div>
{% endblock %}
