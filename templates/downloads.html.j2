{% extends "base.html.j2" %}
{% set active_page = "downloads" %}

{% block title %}Downloads: CVE Remediation Snapshot{% endblock %}

{% block hero %}
  <div class="hero py-4 mb-5">
    <div class="container">
      <p class="section-eyebrow text-white-50 mb-2">Data</p>
      <h1 class="mb-0">Downloads</h1>
    </div>
  </div>
{% endblock %}

{% block content %}
  <div class="card mb-4">
    <div class="card-body">
      <h5 class="card-title">Files</h5>
      <p class="card-text text-muted">
        Both datasets are published one file per CVE year, as gzip-compressed CSV and Parquet.
        There is no combined "all years" file: the history only grows, and a single file would
        eventually break the deploy. Grab the years you need, or loop over all of them (see
        <a href="#dbt">Using with dbt</a> below).
        Generated {{ generated_at }} UTC.
      </p>
      <p class="card-text text-muted">
        <code>cve_summary</code> is one row per CVE. <code>cve_cpe</code> is a child table keyed by
        <code>cve_id</code>, with one row per CPE match and multiple rows per CVE where a CVE
        affects multiple CPEs (see the <a href="schema.html">schema</a>).
      </p>
      <div class="table-responsive mb-0">
        <table class="table table-sm align-middle">
          <thead>
            <tr>
              <th rowspan="2" class="align-bottom">Year</th>
              <th colspan="2" class="text-center border-start">cve_summary</th>
              <th colspan="2" class="text-center border-start">cve_cpe</th>
            </tr>
            <tr>
              <th class="border-start">csv.gz</th>
              <th>parquet</th>
              <th class="border-start">csv.gz</th>
              <th>parquet</th>
            </tr>
          </thead>
          <tbody>
            {% for row in download_rows %}
            <tr>
              <th scope="row">{{ row.year }}</th>
              <td class="border-start">
                {% if row.summary %}🗜️ <a href="{{ row.summary.csv.filename }}">{{ row.summary.csv.filename }}</a>{% else %}<span class="text-muted">none</span>{% endif %}
              </td>
              <td>
                {% if row.summary %}📦 <a href="{{ row.summary.parquet.filename }}">{{ row.summary.parquet.filename }}</a>{% else %}<span class="text-muted">none</span>{% endif %}
              </td>
              <td class="border-start">
                {% if row.cpe %}🗜️ <a href="{{ row.cpe.csv.filename }}">{{ row.cpe.csv.filename }}</a>{% else %}<span class="text-muted">none</span>{% endif %}
              </td>
              <td>
                {% if row.cpe %}📦 <a href="{{ row.cpe.parquet.filename }}">{{ row.cpe.parquet.filename }}</a>{% else %}<span class="text-muted">none</span>{% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="card mb-4" id="dbt">
    <div class="card-body">
      <h5 class="card-title">Using with dbt</h5>
      <p class="card-text text-muted">
        To use a dataset as a <a href="https://docs.getdbt.com/docs/build/seeds" target="_blank" rel="noopener">dbt seed</a>,
        stitch the year files together into your project's <code>seeds/</code> directory: download each
        year from 1999 to now, decompress it, and append it (keeping the header from the first year
        only), then seed the result.
      </p>
      <pre class="bg-body-tertiary p-3 rounded mb-3"><code>dest=seeds/cve_summary.csv
: &gt; "$dest"
for year in $(seq 1999 "$(date +%Y)"); do
    url="{{ site_url }}/cve_summary_${year}.csv.gz"
    if [ -s "$dest" ]; then
        curl -fsSL "$url" | gunzip | tail -n +2 &gt;&gt; "$dest"
    else
        curl -fsSL "$url" | gunzip &gt; "$dest"
    fi
done
dbt seed --select cve_summary</code></pre>
      <p class="card-text text-muted mb-2">
        The same loop builds the <code>cve_cpe</code> child table, swapping the filename:
      </p>
      <pre class="bg-body-tertiary p-3 rounded mb-0"><code>dest=seeds/cve_cpe.csv
: &gt; "$dest"
for year in $(seq 1999 "$(date +%Y)"); do
    url="{{ site_url }}/cve_cpe_${year}.csv.gz"
    if [ -s "$dest" ]; then
        curl -fsSL "$url" | gunzip | tail -n +2 &gt;&gt; "$dest"
    else
        curl -fsSL "$url" | gunzip &gt; "$dest"
    fi
done
dbt seed --select cve_cpe</code></pre>
    </div>
  </div>
{% endblock %}
