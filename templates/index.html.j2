<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CVE Remediation Snapshot</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🛡️</text></svg>">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="container py-5">
    <h1 class="mb-2">CVE Remediation Snapshot</h1>
    <p class="text-muted mb-2"><em>All times are in UTC.</em></p>
    <p class="text-muted mb-4">
      This is not the CVE database itself &mdash; it is a curated snapshot of the columns most useful
      for prioritising vulnerability remediation (severity, attack vector, exploitation state and
      patch availability), derived from the
      <a href="https://nvd.nist.gov/" target="_blank" rel="noopener">National Vulnerability Database (NVD)</a>.
      The NVD is the U.S. government repository of standards-based vulnerability data, maintained by NIST,
      and is the authoritative source for CVE records &mdash; this snapshot should always be verified
      against it.
    </p>

    <div class="row row-cols-1 row-cols-md-2 g-4 mb-4">
      <div class="col">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title">Last Published CVE</h5>
            <p class="card-text fs-4"><a href="{{ last_published_url }}" target="_blank" rel="noopener">{{ last_published_cve }}</a></p>
            <p class="card-text text-muted">{{ last_published_date }}</p>
          </div>
        </div>
      </div>
      <div class="col">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title">Last Modified CVE</h5>
            <p class="card-text fs-4"><a href="{{ last_modified_url }}" target="_blank" rel="noopener">{{ last_modified_cve }}</a></p>
            <p class="card-text text-muted">{{ last_modified_date }}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-body">
        <h5 class="card-title">Downloads</h5>
        <p class="card-text text-muted">
          {{ record_count }} records &mdash; generated {{ generated_at }}
        </p>
        <div class="table-responsive mb-3">
          <table class="table table-sm">
            <tbody>
              <tr>
                <th scope="row">📄 <a href="{{ csv_filename }}">{{ csv_filename }}</a></th>
                <td>{{ csv_size }}</td>
              </tr>
              <tr>
                <th scope="row">🗜️ <a href="{{ csv_gz_filename }}">{{ csv_gz_filename }}</a></th>
                <td>{{ csv_gz_size }}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-body">
        <h5 class="card-title">Using with dbt</h5>
        <p class="card-text text-muted">
          To use this snapshot as a <a href="https://docs.getdbt.com/docs/build/seeds" target="_blank" rel="noopener">dbt seed</a>,
          download the CSV into your project's <code>seeds/</code> directory:
        </p>
        <pre class="bg-body-tertiary p-3 rounded"><code>curl -L -o seeds/{{ csv_filename }} https://cve-db.pages.dev/{{ csv_filename }}
dbt seed --select {{ csv_filename[:-4] }}</code></pre>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-body">
        <h5 class="card-title">Schema</h5>
        <div class="table-responsive">
          <table class="table table-sm table-striped">
            <thead>
              <tr>
                <th>Column</th>
                <th>Type</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              {% for field in schema %}
              <tr>
                <td><code>{{ field.column }}</code></td>
                <td>{{ field.type }}</td>
                <td>{{ field.description }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-body">
        <h5 class="card-title">Sample Data</h5>
        <div class="table-responsive">
          <table class="table table-sm table-striped">
            <thead>
              <tr>
                {% for column in sample_columns %}
                <th>{{ column }}</th>
                {% endfor %}
              </tr>
            </thead>
            <tbody>
              {% for row in sample_rows %}
              <tr>
                {% for column in sample_columns %}
                <td>
                  {% if column == "cve_id" %}
                  <a href="{{ row.cve_url }}" target="_blank" rel="noopener">{{ row[column] }}</a>
                  {% else %}
                  {{ row[column] }}
                  {% endif %}
                </td>
                {% endfor %}
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
