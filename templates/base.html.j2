<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}CVE Remediation Snapshot{% endblock %}</title>
  <meta name="description" content="A curated, remediation-focused snapshot of the National Vulnerability Database, refreshed daily and available as CSV.">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🛡️</text></svg>">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f7f8fa;
    }
    .navbar-brand {
      font-weight: 600;
      letter-spacing: -0.02em;
    }
    .hero {
      background: linear-gradient(135deg, #0f2540 0%, #163a63 60%, #1e4d84 100%);
      color: #fff;
      border-radius: 0 0 1rem 1rem;
    }
    .hero .text-muted {
      color: rgba(255, 255, 255, 0.7) !important;
    }
    .stat-card {
      border: none;
      box-shadow: 0 1px 3px rgba(15, 37, 64, 0.08);
      border-radius: 0.75rem;
    }
    .card {
      border: none;
      box-shadow: 0 1px 3px rgba(15, 37, 64, 0.08);
      border-radius: 0.75rem;
    }
    .card-title {
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    .section-eyebrow {
      text-transform: uppercase;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      color: #6c757d;
    }
    code {
      color: #b4237a;
    }
    pre code {
      color: inherit;
    }
    footer {
      color: #8a94a3;
    }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-md navbar-dark" style="background-color: #0f2540;">
    <div class="container">
      <a class="navbar-brand" href="index.html">🛡️ CVE Remediation Snapshot</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link {% if active_page == 'home' %}active{% endif %}" href="index.html">Home</a></li>
          <li class="nav-item"><a class="nav-link {% if active_page == 'downloads' %}active{% endif %}" href="downloads.html">Downloads</a></li>
          <li class="nav-item"><a class="nav-link {% if active_page == 'schema' %}active{% endif %}" href="schema.html">Schema</a></li>
          <li class="nav-item"><a class="nav-link {% if active_page == 'now-what' %}active{% endif %}" href="now-what.html">Now What?</a></li>
        </ul>
      </div>
    </div>
  </nav>

  {% block hero %}{% endblock %}

  <div class="container py-5">
    {% block content %}{% endblock %}

    <footer class="text-center small py-3">
      Data sourced from the <a href="https://nvd.nist.gov/" target="_blank" rel="noopener">NVD</a> and the
      <a href="https://github.com/CVEProject/cvelistV5" target="_blank" rel="noopener">CVE Program's cvelistV5</a>.
      Not affiliated with NIST, MITRE, or the U.S. government.
    </footer>
  </div>
</body>
</html>
