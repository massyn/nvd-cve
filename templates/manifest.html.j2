{% extends "base.html.j2" %}
{% set active_page = "manifest" %}

{% block title %}Manifest: CVE Remediation Snapshot{% endblock %}

{% block hero %}
  <div class="hero py-4 mb-5">
    <div class="container">
      <p class="section-eyebrow text-white-50 mb-2">Reference</p>
      <h1 class="mb-0">Manifest</h1>
    </div>
  </div>
{% endblock %}

{% block content %}
  <div class="card mb-4">
    <div class="card-body">
      <h5 class="card-title">What it is</h5>
      <p class="card-text text-muted mb-0">
        <a href="{{ manifest_filename }}">{{ manifest_filename }}</a> is a single, self-describing
        JSON file: point a system at it and it knows both the schema and the full file list for
        every table, without needing this website. It carries a <code>_meta</code> section, then one
        entry per table with that table's <code>schema</code> (column name, type, description) and
        <code>files</code> (every published URL, split into <code>csv</code> and <code>parquet</code>).
      </p>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <h5 class="card-title">_meta</h5>
      <div class="table-responsive mb-0">
        <table class="table table-sm table-striped">
          <thead>
            <tr>
              <th>Key</th>
              <th>Value</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>generated_at</code></td>
              <td>{{ manifest._meta.generated_at }} UTC</td>
            </tr>
            <tr>
              <td><code>tables</code></td>
              <td>{{ manifest._meta.tables | join(", ") }}</td>
            </tr>
            <tr>
              <td><code>total_cves</code></td>
              <td>{{ manifest._meta.total_cves }}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  {% for table_name in manifest._meta.tables %}
  {% set table = manifest[table_name] %}
  <div class="card mb-4">
    <div class="card-body">
      <h5 class="card-title"><code>{{ table_name }}</code></h5>
      <p class="card-text text-muted">
        {{ table.schema | length }} schema field(s),
        {{ table.files.csv | length }} csv.gz file(s),
        {{ table.files.parquet | length }} parquet file(s).
      </p>
      <h6 class="mt-3">schema</h6>
      <div class="table-responsive mb-3">
        <table class="table table-sm table-striped">
          <thead>
            <tr>
              <th>Column</th>
              <th>Type</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            {% for column, field in table.schema.items() %}
            <tr>
              <td><code>{{ column }}</code></td>
              <td>{{ field.type }}</td>
              <td>{{ field.description }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <h6>files</h6>
      <p class="card-text text-muted mb-0">
        <code>files.csv</code> and <code>files.parquet</code> each list every year's full URL for
        this table, e.g. <code>{{ table.files.csv[0] }}</code>. See
        <a href="downloads.html#dbt">Downloads</a> for a script that fetches them all.
      </p>
    </div>
  </div>
  {% endfor %}
{% endblock %}
